generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================
// 1. ENUMS
// ==============================
enum PaymentFrequency {
  SEMANAL
  QUINCENAL
  MENSUAL
}

enum ScheduleStatus {
  PENDIENTE
  PAGADO
  PARCIAL
  VENCIDO
}

enum LoanStatus {
  ACTIVO
  VENCIDO
  LIQUIDADO
  CANCELADO
}

enum PaymentType {
  CUOTA_REGULAR
  ABONO_CAPITAL
  CANCELACION_TOTAL
}

enum UserRole {
  ADMIN
  OFFICER
}

// ==============================
// 2. MODELOS DE USUARIO Y CLIENTE
// ==============================
model User {
  id       String   @id @default(uuid())
  email    String   @unique
  password String
  nombre   String
  apellido String
  role     UserRole @default(OFFICER)
  active   Boolean @default(true)


  createdLoans    Loan[]    @relation("CreatedLoans")
  updatedLoans    Loan[]    @relation("UpdatedLoans")
  createdPayments Payment[] @relation("CreatedPayments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([role])
  @@index([active])
}

model Client {
  id               String   @id @default(uuid())
  nombre           String
  apellido         String?
  cedula           String   @unique
  telefono         String
  direccion        String?
  email            String   @unique
  fecha_nacimiento DateTime
  password         String
  moneda           String   @default("DOP")
  estado           String   @default("ACTIVO")

  loans        Loan[]
  evaluaciones Evaluacion[] // Relación añadida para que compile

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==============================
// 3. PRÉSTAMOS (Loans)
// ==============================
model Loan {
  id                 String           @id @default(uuid())
  clientId           String
  evaluacionId       String?          @unique
  evaluacion         Evaluacion?      @relation(fields: [evaluacionId], references: [id])
  monto_principal    Decimal          @db.Decimal(10, 2)
  tasa_interes_anual Decimal          @db.Decimal(10, 4)
  frecuencia_pago    PaymentFrequency @default(MENSUAL)
  plazo_cantidad     Int
  cuota_fija         Decimal          @db.Decimal(10, 2)
  fecha_desembolso   DateTime         @default(now())
  saldo_capital      Decimal          @db.Decimal(10, 2)
  saldo_interes      Decimal          @default(0) @db.Decimal(10, 2)
  estado             LoanStatus       @default(ACTIVO)
  garantias          String?
  configId           String?    
  config             LoanConfig? @relation(fields: [configId], references: [id])




  client               Client                 @relation(fields: [clientId], references: [id])
  amortizationSchedule AmortizationSchedule[]
  payments             Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String
  updatedById String?

  createdBy User  @relation("CreatedLoans", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedLoans", fields: [updatedById], references: [id])

  @@index([clientId])
  @@index([estado])
}

// ==============================
// 4. TABLA DE AMORTIZACIÓN
// ==============================
model AmortizationSchedule {
  id                String         @id @default(uuid())
  loanId            String
  numero_cuota      Int
  fecha_vencimiento DateTime
  monto_cuota       Decimal        @db.Decimal(10, 2)
  capital_cuota     Decimal        @db.Decimal(10, 2)
  interes_cuota     Decimal        @db.Decimal(10, 2)
  saldo_pendiente   Decimal        @db.Decimal(10, 2)
  estado            ScheduleStatus @default(PENDIENTE)

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@index([fecha_vencimiento])
}

// ==============================
// 5. PAGOS
// ==============================
model Payment {
  id                   String      @id @default(uuid())
  loanId               String
  fecha_pago           DateTime    @default(now())
  monto_total_pagado   Decimal     @db.Decimal(10, 2)
  aplicado_a_intereses Decimal     @db.Decimal(10, 2)
  aplicado_a_capital   Decimal     @db.Decimal(10, 2)
  aplicado_a_mora      Decimal     @default(0) @db.Decimal(10, 2)
  tipo_pago            PaymentType

  loan Loan @relation(fields: [loanId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("CreatedPayments", fields: [createdById], references: [id])

  @@index([loanId])
}

// ==============================
// 6. EVALUACIÓN 
// ==============================
model Evaluacion {
  id                      String   @id @default(cuid())
  clienteId               String
  cliente                 Client   @relation(fields: [clienteId], references: [id])
  ingresosMensuales       Float
  gastosMensuales         Float
  porcentajeEndeudamiento Float    @default(40)
  capacidadPago           Float
  cuotaMaxima             Float
  fuenteIngresos          String?
  garantia                String?
  observaciones           String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  Loan                    Loan?
}

// ==============================
// 7. CONFIGURACIÓN DE CRÉDITOS
// ==============================
model LoanConfig {
  id              String   @id @default(uuid())
  nombre          String   // Ejemplo: "Préstamo Personal"
  tasa_interes    Decimal  @db.Decimal(5, 2)
  plazo_maximo    Int      // En meses o cuotas
  mora_porcentaje Decimal  @db.Decimal(5, 2)
  dias_gracia     Int      @default(3)
  
  loans           Loan[]   // Relación con los préstamos creados con esta config

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}